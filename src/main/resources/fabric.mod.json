{
  "schemaVersion": 1,
  "id": "wynn_ai_bridge",
  "version": "${version}",
  "name": "Wynn AI Bridge",
  "description": "Client-side Minecraft/Wynncraft AI bridge with live non-OCR state capture, embedded MCP, Wynncraft knowledge, and locally armed inventory actions.",
  "authors": ["Tanaka"],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.tanaka.wynnaibridge.WynnAiBridgeClient"
    ],
    "modmenu": [
      "dev.tanaka.wynnaibridge.WynnAiBridgeModMenu"
    ]
  },
  "mixins": [
    "wynn_ai_bridge.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_version}"
  },
  "suggests": {
    "modmenu": ">=20.0.2"
  }
}
